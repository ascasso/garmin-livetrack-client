# Optional manual Garmin integration-test settings.
# Copy to .env for local use. Do not commit real session URLs or tokens.

GARMIN_LIVETRACK_PROFILE_NAME=ascasso
GARMIN_LIVETRACK_EXPECT_ACTIVE=true
GARMIN_LIVETRACK_USER_AGENT='Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:151.0) Gecko/20100101 Firefox/151.0'

# Optional: only set this when testing a known session telemetry/API URL directly.
# GARMIN_LIVETRACK_SESSION_URL=https://...
